@prefix ns1: <http://fuzzy-sl.squirrel.link/ontology/> .
@prefix ns2: <http://w3id.org/geo-lod/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/geo-lod/ci/cisite_5_activity> a ns1:Georeferencing,
        <http://www.w3.org/ns/ldp#Resource>,
        prov:Activity,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    ns1:activityDesc "set a representative point based on scientific papers using OSM Node 337519639"@en ;
    ns1:hasSource ns1:PaperDesc ;
    ns1:hasSourceType ns1:Paper ;
    void:inDataset ns2:geo-lod ;
    ns2:hasCertaintyLevel ns1:high ;
    ns2:hasLiteratureReference "Fedele et al., 2008",
        "Giaccio et al., 2008" ;
    prov:used <http://w3id.org/geo-lod/ci/cisite_5> ;
    prov:wasAssociatedWith <http://orcid.org/0000-0002-3246-3531> .

