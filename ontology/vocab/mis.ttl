mis:source_railsback2015
    a geolod:DataSource, owl:NamedIndividual ;
    rdfs:label "Railsback et al. (2015)"@en ;
    dct:bibliographicCitation "Railsback, L.B., Gibbard, P.L., Head, M.J., Voarintsoa, N.R.G., Toucanne, S. (2015): An optimized scheme of lettered marine isotope substages for the last 1.0 million years, and the climatostratigraphic nature of isotope stages and substages. Quaternary Science Reviews 111, 94-106."@en ;
    geolod:coverageOldestAgeKaBP "1013.1"^^xsd:decimal ;
    dct:source <https://doi.org/10.1016/j.quascirev.2015.01.012> .

mis:source_lisieckiRaymo2005
    a geolod:DataSource, owl:NamedIndividual ;
    rdfs:label "Lisiecki & Raymo (2005), LR04"@en ;
    dct:bibliographicCitation "Lisiecki, L.E., Raymo, M.E. (2005): A Pliocene-Pleistocene stack of 57 globally distributed benthic d18O records. Palaeoceanography 20, PA1003."@en ;
    dct:source <https://doi.org/10.1029/2004PA001071> .

