<http://w3id.org/geo-lod/vocab/mis/>
    a skos:ConceptScheme, owl:Ontology ;
    rdfs:label   "geo-lod Marine Isotope Stage Vocabulary"@en ;
    dct:title    "Marine Isotope Stages and Substages"@en ;
    skos:scopeNote """Railsback et al. (2015) point out that their lettered substages label excursions rather than the transitions between them, so the boundary ages of their table are gradational rather than exact instants. The values are reproduced here as published, without rounding; consumers should treat them as approximate."""@en ;
    skos:editorialNote """Concepts up to 1013.1 ka BP follow Railsback et al. (2015), which is the leading scheme for all MIS assignments in geo-lod. Older concepts are taken from the LR04 boundaries of Lisiecki & Raymo (2005), the only source covering that range."""@en ;
    owl:imports  <http://w3id.org/geo-lod/> ;
    dct:created  "2026-08-08"^^xsd:date ;
    owl:versionInfo "sha256:f031e6017451" ;
    prov:wasGeneratedBy mis:vocabulary_generation ;
    dct:source   mis:source_railsback2015, mis:source_lisieckiRaymo2005 .

