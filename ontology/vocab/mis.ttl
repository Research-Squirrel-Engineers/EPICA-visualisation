# --------------------------------------------------------------------------

mis:assign_climateMode_MIS_1
    a geolod:MISAttributeAssignment ;
    crm:P140_assigned_attribute_to mis:MIS_1 ;
    crm:P141_assigned geolod:ClimateMode_Warm ;
    crm:P177_assigned_property_of_type geolod:ClimateModeType ;
    geolod:assignmentStatus geolod:LeadingAssignment ;
    rdfs:comment "Parity convention: odd-numbered stages are warm, even-numbered stages cold, as discussed by Railsback et al. (2015)."@en ;
    dct:source mis:source_railsback2015 .

