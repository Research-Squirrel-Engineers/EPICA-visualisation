# ============================================================================
# mis_shapes.ttl
# geo-lod SHACL Shapes — Marine Isotope Stage vocabulary
# <http://w3id.org/geo-lod/shapes/mis>
#
# Purpose
#   Validates the controlled vocabulary under
#   <http://w3id.org/geo-lod/vocab/mis/>, generated by
#   ontology/build_mis_vocab.py.
#
# Severity policy
#   sh:Violation  -- a concept without label, scheme membership or source is
#                    not usable as a shared vocabulary term; an assignment
#                    without target, value, property type or source loses the
#                    competing-readings pattern the vocabulary is built on.
#   sh:Warning    -- ages outside the range covered by the sources, and stages
#                    without a materialised boundary.
#
# Shape groups
#   E.1  MarineIsotopeStage / MarineIsotopeSubstage
#   E.2  MISAttributeAssignment
#   E.3  time:TimePosition
#
# Validation
#   Picked up automatically by the SHACL step in bundle_rdf.py.
# ============================================================================

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

@prefix crm:        <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix geolod:     <http://w3id.org/geo-lod/> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix time:       <http://www.w3.org/2006/time#> .
@prefix dct:        <http://purl.org/dc/terms/> .

<http://w3id.org/geo-lod/shapes/mis>
    a owl:Ontology ;
    rdfs:label   "geo-lod SHACL Shapes — MIS vocabulary"@en ;
    rdfs:comment "Data-quality constraints for the Marine Isotope Stage vocabulary under <http://w3id.org/geo-lod/vocab/mis/>."@en .


# ============================================================================
# E.1  MARINE ISOTOPE STAGE
# ============================================================================
# Every concept carries a preferred label, belongs to the scheme, and names
# the source it comes from. Substages additionally point at their parent.

geolod:MarineIsotopeStageShape
    a sh:NodeShape ;
    sh:targetClass geolod:MarineIsotopeStage ;

    sh:property [
        sh:path     skos:prefLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        sh:message  "Every MIS concept needs exactly one skos:prefLabel." ;
    ] ;

    sh:property [
        sh:path     skos:altLabel ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "Every MIS concept needs the bare designation as skos:altLabel." ;
    ] ;

    sh:property [
        sh:path     skos:inScheme ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://w3id.org/geo-lod/vocab/mis/> ;
        sh:severity sh:Violation ;
        sh:message  "Every MIS concept must be in the MIS concept scheme." ;
    ] ;

    sh:property [
        sh:path     dct:source ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message  "Every MIS concept must name the source that defines it." ;
    ] ;

    sh:property [
        sh:path     geolod:leadingSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message  "Every MIS concept must name the source geo-lod follows for it." ;
    ] ;

    sh:property [
        sh:path     geolod:climateMode ;
        sh:maxCount 1 ;
        sh:class    geolod:ClimateMode ;
        sh:severity sh:Violation ;
        sh:message  "climateMode must be a single geolod:ClimateMode individual." ;
    ] ;

    sh:property [
        sh:path        geolod:beginAgeKaBP ;
        sh:maxCount    1 ;
        sh:datatype    xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 6000 ;
        sh:severity    sh:Warning ;
        sh:message     "beginAgeKaBP outside the range covered by the sources (0-6000 ka BP)." ;
    ] ;

    sh:property [
        sh:path        geolod:endAgeKaBP ;
        sh:maxCount    1 ;
        sh:datatype    xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 6000 ;
        sh:severity    sh:Warning ;
        sh:message     "endAgeKaBP outside the range covered by the sources (0-6000 ka BP)." ;
    ] ;

    sh:or (
        [ sh:property [ sh:path geolod:beginAgeKaBP ; sh:minCount 1 ] ]
        [ sh:property [ sh:path geolod:endAgeKaBP   ; sh:minCount 1 ] ]
    ) ;
    sh:severity sh:Warning ;
    sh:message  "MIS concept without any materialised boundary age." .


geolod:MarineIsotopeSubstageShape
    a sh:NodeShape ;
    sh:targetClass geolod:MarineIsotopeSubstage ;

    sh:property [
        sh:path     skos:broader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class    geolod:MarineIsotopeStage ;
        sh:severity sh:Violation ;
        sh:message  "Every substage must point at exactly one parent stage." ;
    ] .


# ============================================================================
# E.2  MIS ATTRIBUTE ASSIGNMENT
# ============================================================================
# The competing-readings pattern only works if each assignment states what it
# assigns, to what, of which kind, and on whose authority.

geolod:MISAttributeAssignmentShape
    a sh:NodeShape ;
    sh:targetClass geolod:MISAttributeAssignment ;

    sh:property [
        sh:path     crm:P140_assigned_attribute_to ;
        sh:minCount 1 ;
        sh:class    geolod:MarineIsotopeStage ;
        sh:severity sh:Violation ;
        sh:message  "An MIS assignment must target at least one MIS concept." ;
    ] ;

    sh:property [
        sh:path     crm:P141_assigned ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message  "An MIS assignment must carry the assigned value." ;
    ] ;

    sh:property [
        sh:path     crm:P177_assigned_property_of_type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class    geolod:AssignedPropertyType ;
        sh:severity sh:Violation ;
        sh:message  "An MIS assignment must state which property it assigns." ;
    ] ;

    sh:property [
        sh:path     dct:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message  "An MIS assignment must name exactly one source; competing readings stay separate assignments." ;
    ] ;

    sh:property [
        sh:path     geolod:assignmentStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class    geolod:AssignmentStatus ;
        sh:severity sh:Violation ;
        sh:message  "An MIS assignment must state whether it leads or is an alternative reading." ;
    ] .


# ============================================================================
# E.3  TIME POSITION
# ============================================================================
# An age is only interpretable together with the reference system it belongs
# to, so both are required.

geolod:TimePositionShape
    a sh:NodeShape ;
    sh:targetClass time:TimePosition ;

    sh:property [
        sh:path     time:numericPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message  "A time position needs exactly one numeric value." ;
    ] ;

    sh:property [
        sh:path     time:hasTRS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message  "A time position needs the temporal reference system it is expressed in." ;
    ] ;

    sh:property [
        sh:path     geolod:ageKaBP ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Warning ;
        sh:message  "A time position should also carry geolod:ageKaBP for direct querying." ;
    ] .
