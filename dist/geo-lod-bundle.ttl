    geolod:hasCertaintyDescription "findspot mentioned in a scientific paper"@en ;
    geolod:hasCertaintyLevel fsl:low ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(31.8000 47.4300)"^^geo:wktLiteral .

