geolod:Delta18OProperty a owl:Class ;
    rdfs:label "δ¹⁸O Property"@en ;
    rdfs:comment "Stable oxygen isotope ratio (δ¹⁸O), shared by both  ice-core and speleothem records."@en ;
    rdfs:subClassOf geolod:ObservableProperty .

geolod:DrillingCampaign a owl:Class ;
    rdfs:label "Drilling Campaign"@en ;
    rdfs:comment "A field campaign during which an ice core was drilled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:tookPlaceAt ;
            owl:someValuesFrom geolod:DrillingSite ],
        crm:E7_Activity,
        crmsci:S1_Matter_Removal .

geolod:MesoamericanContext a geolod:ArchaeologicalContext,
        owl:NamedIndividual ;
    rdfs:label "Mesoamerican Context"@en .

geolod:ageChronology a owl:ObjectProperty ;
    rdfs:label "age chronology"@en ;
    rdfs:comment "Links an observation to the depth-age model used."@en .

geolod:atDepth_m a owl:DatatypeProperty ;
    rdfs:label "at depth (m)"@en ;
    qudt:unit unit:M ;
    rdfs:comment "Depth below the surface of the archive, in metres. In an  ice core this is the measured quantity and the age is the derived one."@en ;
    rdfs:range xsd:decimal .

epica:geom_borehole_edc99 a sf:Point,
        owl:NamedIndividual ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(123.350000 -75.100000)"^^geo:wktLiteral .

geolod:tookPlaceAt a owl:ObjectProperty ;
    rdfs:label "took place at"@en ;
    rdfs:comment "Links a sampling event or campaign to its location."@en ;
    rdfs:range geolod:SamplingLocation .

