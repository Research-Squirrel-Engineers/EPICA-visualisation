mis:MIS_3 a geolod:MarineIsotopeStage,
        skos:Concept ;
    dct:source mis:source_lisieckiRaymo2005,
        mis:source_railsback2015 ;
    geolod:beginAgeKaBP 57.3 ;
    geolod:climateMode geolod:ClimateMode_Warm ;
    geolod:endAgeKaBP 35.0 ;
    geolod:leadingSource mis:source_railsback2015 ;
    skos:altLabel "3"@en ;
    skos:editorialNote "Stage-level boundaries derived as the union of the substage intervals; Railsback et al. (2015) list no stage row."@en ;
    skos:inScheme mis: ;
    skos:note "Earlier geo-lod figures rendered MIS 3 as an interstadial (MIS_INTERVALS in SISAL/plot_sisal_from_csv.py). The parity convention applied here classifies it as warm."@en ;
    skos:prefLabel "MIS 3"@en ;
    skos:topConceptOf mis: .

