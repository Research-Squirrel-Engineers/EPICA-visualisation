geolod:Chronology a owl:Class ;
    rdfs:label "Chronology"@en ;
    rdfs:comment "A depth-age model assigning calendar ages to positions  within a palaeoclimate archive."@en ;
    rdfs:subClassOf crmsci:S4_Observation .

geolod:Delta18OProperty a owl:Class ;
    rdfs:label "δ¹⁸O Property"@en ;
    rdfs:comment "Stable oxygen isotope ratio (δ¹⁸O), shared by both  ice-core and speleothem records."@en ;
    rdfs:subClassOf geolod:ObservableProperty .

geolod:DrillingCampaign a owl:Class ;
    rdfs:label "Drilling Campaign"@en ;
    rdfs:comment "A scientific field campaign during which an ice core was drilled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:tookPlaceAt ;
            owl:someValuesFrom geolod:DrillingSite ],
        [ a owl:Restriction ;
            owl:onProperty geolod:removedSample ;
            owl:someValuesFrom geolod:IceCore ],
        crm:E7_Activity,
        crmsci:S1_Matter_Removal .

geolod:IceCoreChronology a owl:Class ;
    rdfs:label "Ice Core Chronology"@en ;
    rdfs:comment "A depth-age model for an ice core (e.g. EDC2, AICC2023)."@en ;
    rdfs:subClassOf geolod:Chronology .

geolod:MesoamericanContext a geolod:ArchaeologicalContext,
        owl:NamedIndividual ;
    rdfs:label "Mesoamerican Context"@en .

geolod:Obs_CH4_0000 a crmsci:S4_Observation,
        sosa:Observation ;
    rdfs:label "CH₄ observation 0000 (0.0 ka BP)"@en ;
    qudt:unit unit:PPB ;
    geolod:ageChronology geolod:EDC2_Chronology ;
    geolod:atDepth_m 99.34 ;
    geolod:measurementType geolod:MeasurementType_CH4 ;
    geolod:smoothedValue_rollingMedian 683.5 ;
    geolod:smoothedValue_savgol 841.89 ;
    geolod:smoothingMethod_median geolod:RollingMedian_w11 ;
    geolod:smoothingMethod_savgol geolod:SavitzkyGolay_w11_p2 ;
    crm:P7_took_place_at geolod:EpicaDomeC_Site ;
    prov:wasDerivedFrom <https://doi.org/10.1594/PANGAEA.472484> ;
    sosa:hasFeatureOfInterest geolod:EpicaDomeC_IceCore ;
    sosa:hasSimpleResult 907.0 ;
    sosa:observedProperty geolod:CH4Concentration ;
    sosa:resultTime 0.0 .

geolod:Obs_CH4_0001 a crmsci:S4_Observation,
        sosa:Observation ;
    rdfs:label "CH₄ observation 0001 (0.1 ka BP)"@en ;
    qudt:unit unit:PPB ;
    geolod:ageChronology geolod:EDC2_Chronology ;
    geolod:atDepth_m 102.58 ;
    geolod:measurementType geolod:MeasurementType_CH4 ;
    geolod:smoothedValue_rollingMedian 684.3 ;
    geolod:smoothedValue_savgol 788.19 ;
    geolod:smoothingMethod_median geolod:RollingMedian_w11 ;
    geolod:smoothingMethod_savgol geolod:SavitzkyGolay_w11_p2 ;
    crm:P7_took_place_at geolod:EpicaDomeC_Site ;
    prov:wasDerivedFrom <https://doi.org/10.1594/PANGAEA.472484> ;
    sosa:hasFeatureOfInterest geolod:EpicaDomeC_IceCore ;
