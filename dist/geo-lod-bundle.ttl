crm:E13_Attribute_Assignment rdfs:label "Attribute Assignment"@en ;
    rdfs:comment "An act of assigning a property to an entity, on the authority of some source (CIDOC-CRM E13)."@en .

crm:E22_Human-Made_Object rdfs:label "Human-Made Object"@en ;
    rdfs:comment "CRM E22: A human-made object (e.g. drilled ice core)."@en .

crm:E53_Place rdfs:label "Place"@en ;
    rdfs:comment "An extent in space (CIDOC-CRM E53)."@en .

crmsci:S1_Matter_Removal rdfs:label "Matter Removal"@en ;
    rdfs:comment "A process of removing matter from an object (CRMsci S1)."@en,
        "CRMsci S1: A physical event where matter is removed (e.g. drilling)."@en .

sosa:ObservableProperty rdfs:label "Observable Property"@en ;
    rdfs:subClassOf crmsci:S9_Property_Type .

geolod:AssignedPropertyType a owl:Class ;
    rdfs:label "Assigned Property Type"@en ;
    rdfs:comment "The kind of property an attribute assignment establishes (crm:P177)."@en ;
    rdfs:subClassOf crm:E55_Type .

geolod:Cave_site_0144 a geolod:Cave ;
    rdfs:label "Botuverá cave"@en ;
    geolod:countD13CSamples 920 ;
    geolod:countD18OSamples 920 ;
    geolod:siteId 144 ;
    geo:hasGeometry geolod:Cave_site_0144_Geometry ;
    prov:wasDerivedFrom geolod:SISALv3_DataSource .

geolod:MeasurementType a owl:Class ;
    rdfs:label "Measurement Type"@en ;
    rdfs:comment "Classifies an observation by the physical quantity measured."@en ;
    rdfs:subClassOf crmsci:S6_Data_Evaluation .

geolod:ObservableProperty a owl:Class ;
    rdfs:label "Observable Property"@en ;
    rdfs:comment "A measurable geochemical or physical property of a  palaeoclimate sample (e.g. δ¹⁸O, δ¹³C, CH₄ concentration)."@en ;
    rdfs:subClassOf crmsci:S9_Property_Type,
        sosa:ObservableProperty .

geolod:SamplingLocation a owl:Class ;
    rdfs:label "Sampling Location"@en ;
    rdfs:comment "A geographically identified location from which palaeoclimate  proxy material was obtained (ice-core drilling site or speleothem cave)."@en ;
    rdfs:subClassOf crm:E27_Site,
        crm:E53_Place,
        geo:Feature .

geolod:SpeleothemObservation a owl:Class ;
    rdfs:label "Speleothem Observation"@en ;
    rdfs:comment "Single stable isotope measurement on a speleothem sample, characterised by depth (mm), calendar age (ka BP) and measured value. Corresponds to a row in the d18O or d13C table of SISALv3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom geolod:Speleothem ],
        [ a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom geolod:ObservableProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom geolod:DataSource ],
        geolod:PalaeoclimateObservation .

