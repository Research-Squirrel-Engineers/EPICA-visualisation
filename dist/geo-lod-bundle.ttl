geolod:ClimateMode a owl:Class ;
    rdfs:label "Climate Mode"@en ;
    rdfs:comment "Classifies a Marine Isotope Stage as warm or cold."@en ;
    rdfs:subClassOf crm:E55_Type .

geolod:DrillingSite a owl:Class ;
    rdfs:label "Ice Core Drilling Site"@en ;
    rdfs:comment "The geographical location where an ice core was drilled."@en ;
    rdfs:subClassOf geolod:SamplingLocation .

geolod:HistoricContext a geolod:ArchaeologicalContext,
        owl:NamedIndividual ;
    rdfs:label "Historic Context"@en .

geolod:IceCore a owl:Class ;
    rdfs:label "Ice Core"@en ;
    rdfs:comment "A cylindrical ice sample extracted by drilling from a glacier or ice sheet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:extractedFrom ;
            owl:someValuesFrom geolod:DrillingSite ],
        geolod:PalaeoclimateSample,
        crm:E22_Human-Made_Object .

geolod:IceCoreDataset a owl:Class ;
    rdfs:label "Ice Core Dataset"@en ;
    rdfs:comment "A dataset derived from measurements on an ice core."@en ;
    rdfs:subClassOf dcat:Dataset .

geolod:IceCoreObservation a owl:Class ;
    rdfs:label "Ice Core Observation"@en ;
    rdfs:comment "A single measurement on an ice core sample (depth, age, value)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom geolod:IceCore ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom geolod:DataSource ],
        geolod:PalaeoclimateObservation .

geolod:PalaeoclimateSample a owl:Class ;
    rdfs:label "Palaeoclimate Sample"@en ;
    rdfs:comment "A physical archive recording a palaeoclimate signal  (ice core or speleothem)."@en ;
    rdfs:subClassOf crm:E18_Physical_Thing,
        sosa:Sample .

geolod:PalaeontologicalContext a geolod:ArchaeologicalContext,
        owl:NamedIndividual ;
    rdfs:label "Palaeontological Context"@en .

geolod:SavitzkyGolayFilter a owl:Class ;
    rdfs:label "Savitzky-Golay Filter"@en ;
    rdfs:comment "Polynomial least-squares smoothing filter preserving  higher signal moments."@en ;
    rdfs:subClassOf geolod:SmoothingMethod .

geolod:SmoothingMethod a owl:Class ;
    rdfs:label "Smoothing Method"@en ;
    rdfs:comment "A numerical method applied to reduce high-frequency  noise in a palaeoclimate time series."@en ;
    rdfs:subClassOf crmsci:S6_Data_Evaluation .

geolod:ageKaBP a owl:DatatypeProperty ;
    rdfs:label "age (ka BP)"@en ;
    rdfs:comment "Age in thousands of years before present (ka BP)."@en ;
    rdfs:range xsd:decimal .

