ci:cisite_101_activity a fsl:Georeferencing,
        prov:Activity ;
    fsl:activityDesc "set a representative point based on scientific papers using Google Maps"@en ;
    fsl:hasSource fsl:PaperDesc ;
    fsl:hasSourceType fsl:Paper ;
    geolod:hasCertaintyLevel fsl:medium ;
    geolod:hasLiteratureReference "Obreht, I. et al. (2015)",
        "Obreht, I. et al. (2017), Fig. 1" ;
    prov:used ci:cisite_101 ;
    prov:wasAssociatedWith <http://orcid.org/0000-0002-3246-3531> .

ci:cisite_101_geom a crmgeo:SP6_Declarative_Place,
        sf:Point ;
    geolod:hasCertaintyDescription "findspot mentioned in a scientific paper"@en ;
    geolod:hasCertaintyLevel fsl:medium ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(20.5809 45.2417)"^^geo:wktLiteral .

ci:cisite_101_pyscript a prov:Activity ;
    prov:wasAssociatedWith <https://github.com/Research-Squirrel-Engineers/campanian-ignimbrite-geo/blob/main/py/CI.py> ;
    prov:wasInformedBy ci:ci_findspots_generation .

