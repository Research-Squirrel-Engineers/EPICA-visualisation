geolod:Delta13CProperty a owl:Class ;
    rdfs:label "delta-13C Isotope Ratio Property"@en ;
    rdfs:comment "Stable carbon isotope ratio (delta-13C) in permille VPDB. Sensitive to vegetation dynamics, soil respiration, and prior calcite precipitation."@en ;
    rdfs:subClassOf geolod:ObservableProperty .

