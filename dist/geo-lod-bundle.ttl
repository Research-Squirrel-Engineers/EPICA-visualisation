geolod:climateMode a owl:ObjectProperty ;
    rdfs:label "climate mode"@en ;
    rdfs:comment "Materialised warm/cold classification. The assignment carrying the source is kept alongside as a geolod:MISAttributeAssignment."@en ;
    rdfs:domain geolod:MarineIsotopeStage ;
    rdfs:range geolod:ClimateMode .

geolod:countD13CSamples a owl:DatatypeProperty ;
    rdfs:label "count of d13C samples"@en ;
    rdfs:comment "Total number of delta-13C measurements available for this cave site across all entities in SISALv3 (column: n_d13c_samples in v_sites_all)."@en ;
    rdfs:domain geolod:Cave ;
    rdfs:range xsd:integer .

geolod:countD18OSamples a owl:DatatypeProperty ;
    rdfs:label "count of d18O samples"@en ;
    rdfs:comment "Total number of delta-18O measurements available for this cave site across all entities in SISALv3 (column: n_d18o_samples in v_sites_all)."@en ;
    rdfs:domain geolod:Cave ;
    rdfs:range xsd:integer .

geolod:coverageOldestAgeKaBP a owl:DatatypeProperty ;
    rdfs:label "oldest age covered (ka BP)"@en ;
    rdfs:comment "Oldest age a source reaches. Beyond it another source has to lead."@en ;
    rdfs:domain geolod:DataSource ;
    rdfs:range xsd:decimal .

geolod:crm-bridging a owl:Ontology ;
    rdfs:label "geo-lod ↔ CIDOC-CRM Bridging Axioms"@en ;
    dct:created "2026-04"^^xsd:gYearMonth ;
    rdfs:comment "Bridges external standard vocabularies (SOSA, PROV-O, GeoSPARQL, DCAT, FOAF, Dublin Core, Pleiades, fuzzy-sl) into the CIDOC-CRM family so that every instance in the geo-lod knowledge graph has a CRM-family ancestor. Required for ingestion into the NFDI4Objects Knowledge Graph."@en ;
    owl:imports geolod: .

geolod:depthBottom_m a owl:DatatypeProperty ;
    rdfs:label "bottom depth (m)"@en ;
    rdfs:comment "Lower, older bound of a sample section."@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf geolod:atDepth_m .

geolod:depthTop_m a owl:DatatypeProperty ;
    rdfs:label "top depth (m)"@en ;
    rdfs:comment "Upper, younger bound of a sample section."@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf geolod:atDepth_m .

geolod:elevation_m a owl:DatatypeProperty ;
    rdfs:label "elevation (m)"@en ;
    qudt:unit unit:M ;
    rdfs:comment "Surface elevation above sea level, in metres."@en ;
    rdfs:range xsd:decimal .

geolod:endAgeKaBP a owl:DatatypeProperty ;
    rdfs:label "end age (ka BP)"@en ;
    rdfs:comment "Materialised younger boundary of a period, taken from the leading source."@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf geolod:ageKaBP .

geolod:entityId a owl:DatatypeProperty ;
    rdfs:label "SISAL entity ID"@en ;
    rdfs:comment "Unique dataset identifier in SISALv3 (entity_id). Multiple entity_ids may share the same persist_id (same physical speleothem, different time windows)."@en ;
    rdfs:domain geolod:Speleothem ;
    rdfs:range xsd:integer .

geolod:epica a owl:Ontology ;
    rdfs:label "EPICA Dome C Ice Core Ontology"@en ;
    dct:created "2026-08-08"^^xsd:date ;
    dct:description "Extension of the geo-lod core ontology for ice-core palaeoclimate records. Covers the drilling site and its boreholes, the core and its sections, the observations of five proxies and the depth-age models their ages rest on."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "EPICA Dome C Ice Core Ontology"@en ;
    owl:imports geolod: ;
    owl:versionInfo "2.0.0" .

epica:borehole_domec a geolod:Borehole,
        owl:NamedIndividual ;
    rdfs:label "DomeC"@en ;
    geolod:elevation_m 3233.0 ;
    crm:P89_falls_within epica:site_dome_c ;
    geo:hasGeometry epica:geom_borehole_domec ;
    rdfs:comment "Event as recorded in the two 2023 gas datasets. The coordinates differ from the EDC99 event by about 1.3 km although the material is from the same core; this is a difference between metadata records, not evidence of a second borehole."@en .

epica:borehole_edc99 a geolod:Borehole,
        owl:NamedIndividual ;
    rdfs:label "EDC99 / EDC (EPICA Dome C)"@en ;
    geolod:elevation_m 3233.0 ;
    crm:P89_falls_within epica:site_dome_c ;
    geo:hasGeometry epica:geom_borehole_edc99 ;
    rdfs:comment "Event as recorded in the CH4, deuterium and dust datasets. Drilling ran 1996-2004; the first hole (EDC96) was abandoned at 788 m in 1999 and the record continues in EDC99."@en .

epica:campaign_1996_2004 a geolod:DrillingCampaign,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C drilling campaign 1996-2004"@en ;
    geolod:removedSample epica:core_edc ;
    geolod:tookPlaceAt epica:site_dome_c ;
    crm:P4_has_time-span "1996/2004"^^xsd:string ;
    crmsci:O1_removed epica:core_edc .

epica:catalog a geolod:PalaeoclimateDataCatalogue,
        owl:NamedIndividual,
        dcat:Catalog ;
    rdfs:label "EPICA Dome C ice core - linked data catalogue"@en ;
    dct:created "2026-08-08"^^xsd:date ;
    dct:description "Five proxy records from the EPICA Dome C ice core, East Antarctica: methane, deuterium, dust, the oxygen isotope composition of trapped air, and the oxygen to nitrogen ratio of trapped air. The records rest on four different depth-age models and are not on a common time axis; each observation names the chronology its age comes from."@en ;
    dct:publisher "PANGAEA - Data Publisher for Earth & Environmental Science" ;
    dct:title "EPICA Dome C ice core - linked data catalogue"@en ;
    dcat:dataset epica:dataset_ch4,
        epica:dataset_d18o,
        epica:dataset_dd,
        epica:dataset_do2n2,
        epica:dataset_dust .

epica:collection_drilling_sites a geo:FeatureCollection,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C drilling site collection"@en ;
    rdfs:member epica:site_dome_c .

