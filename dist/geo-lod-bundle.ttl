geolod:UThChronology_144_botuvera a geolod:UThChronology ;
    rdfs:label "U-Th Chronology – Botuverá cave"@en ;
    rdfs:comment "Standardised SISAL chronology (linear interpolation / Bchron / Bacon / copRa / StalAge). See SISALv3 repository: https://doi.org/10.5287/ora-2nanwp4rk"@en .

trs:EDC2-gas a geolod:IceCoreChronology,
        owl:NamedIndividual,
        time:TRS ;
    rdfs:label "EDC2 gas age, EPICA Dome C (ka BP)"@en ;
    dct:source <https://doi.org/10.1029/2000JD900527> ;
    rdfs:comment "Gas-age branch of the EPICA Dome C timescale of Schwander et al. (2001). Dates the air trapped in the bubbles. Used by the CH4 record."@en .

geolod:UThChronology_275_buracagloriosa a geolod:UThChronology ;
    rdfs:label "U-Th Chronology – Buraca Gloriosa"@en ;
    rdfs:comment "Standardised SISAL chronology (linear interpolation / Bchron / Bacon / copRa / StalAge). See SISALv3 repository: https://doi.org/10.5287/ora-2nanwp4rk"@en .

trs:EDC2-ice a geolod:IceCoreChronology,
        owl:NamedIndividual,
        time:TRS ;
    rdfs:label "EDC2 ice age, EPICA Dome C (ka BP)"@en ;
    dct:source <https://doi.org/10.1029/2000JD900527> ;
    rdfs:comment "Ice-age branch of the same timescale. Dates the ice matrix. Used by the deuterium record, whose averaging intervals the source states in years before 1950 on EDC2."@en .

geolod:UThChronology_145_corchia a geolod:UThChronology ;
    rdfs:label "U-Th Chronology – Antro del Corchia"@en ;
    rdfs:comment "Standardised SISAL chronology (linear interpolation / Bchron / Bacon / copRa / StalAge). See SISALv3 repository: https://doi.org/10.5287/ora-2nanwp4rk"@en .

trs:AICC2023-ice a geolod:IceCoreChronology,
        owl:NamedIndividual,
        time:TRS ;
    rdfs:label "AICC2023 ice age, EPICA Dome C (ka BP)"@en ;
    dct:source <https://doi.org/10.5194/cp-19-2257-2023> ;
    rdfs:comment "Ice-age branch of the Antarctic Ice Core Chronology 2023. Dates the ice matrix itself. Offset against the gas age of the same depth by the gas-age/ice-age difference."@en .

unit:PERMILLE rdfs:label "Per Mille"@en .

geolod:Delta13CSpeleothemObservation a owl:Class ;
    rdfs:label "delta-13C Speleothem Observation"@en ;
    rdfs:comment "Carbon isotope ratio (delta-13C) in permille VPDB from a speleothem. Proxy for vegetation density, soil CO2, prior calcite precipitation (Wong & Breecker 2015)."@en ;
    rdfs:subClassOf geolod:SpeleothemObservation .

geolod:Delta13C_Speleothem a geolod:Delta13CProperty ;
    rdfs:label "delta-13C (speleothem)"@en .

geolod:MeasurementType_d13C a geolod:MeasurementType ;
    rdfs:label "delta-13C Measurement"@en ;
    rdfs:comment "Stable carbon isotope ratio (delta-13C) in permille VPDB. SISALv3 table: d13C. Proxy: vegetation, soil CO2, prior calcite precipitation."@en .

trs:EDC3-ice a geolod:IceCoreChronology,
        owl:NamedIndividual,
        time:TRS ;
    rdfs:label "EDC3 ice age, EPICA Dome C (ka BP)"@en ;
    dct:source <https://doi.org/10.5194/cp-3-485-2007> ;
    rdfs:comment "EPICA Dome C timescale of Parrenin et al. (2007), an ice-flow age model. Used by the dust record, which is measured on the ice."@en .

trs:AICC2023-gas a geolod:IceCoreChronology,
        owl:NamedIndividual,
        time:TRS ;
    rdfs:label "AICC2023 gas age, EPICA Dome C (ka BP)"@en ;
    dct:source <https://doi.org/10.5194/cp-19-2257-2023> ;
    rdfs:comment "Gas-age branch of the Antarctic Ice Core Chronology 2023. Dates the air trapped in the bubbles, which is younger than the surrounding ice."@en .

geolod:IceCoreObservation a owl:Class ;
    rdfs:label "Ice Core Observation"@en ;
    rdfs:comment "A single measured value at a known depth in an ice core. The depth is what was measured; the age is derived from it through a chronology, which the observation names."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:ageChronology ;
            owl:someValuesFrom geolod:IceCoreChronology ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom geolod:DataSource ],
        geolod:PalaeoclimateObservation .

geolod:MISMembership a geolod:AssignedPropertyType,
        owl:NamedIndividual ;
    rdfs:label "marine isotope stage membership"@en ;
    rdfs:comment "The stage an observation falls in."@en .

geolod:MISMembershipAssignment a owl:Class ;
    rdfs:label "MIS Membership Assignment"@en ;
    rdfs:comment "Places an observation in a Marine Isotope Stage, on the  authority of one boundary source and through one chronology. Deliberately not  a subclass of geolod:MISAttributeAssignment: that one assigns properties *to*  a stage, this one assigns a stage *to* something else, and the two carry  different constraints."@en ;
    rdfs:subClassOf crm:E13_Attribute_Assignment .

epica:smoothing_rolling_median_w11 a geolod:RollingMedianFilter,
        owl:NamedIndividual ;
    rdfs:label "Rolling median filter, window 11"@en ;
    dct:references <https://doi.org/10.1145/1968.1969> ;
    geolod:windowSize 11 .

epica:smoothing_savitzky_golay_w11_p2 a geolod:SavitzkyGolayFilter,
        owl:NamedIndividual ;
    rdfs:label "Savitzky-Golay filter, window 11, polynomial order 2"@en ;
    dct:references <https://doi.org/10.1021/ac60214a047> ;
    geolod:polyOrder 2 ;
    geolod:windowSize 11 .

epica:site_dome_c a geolod:DrillingSite,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C, East Antarctica"@en ;
    crm:P87_is_identified_by "EDC"^^xsd:string ;
    geo:hasGeometry epica:geom_borehole_edc99 ;
    rdfs:comment "Drilling site of the European Project for Ice Coring in Antarctica on the East Antarctic plateau, 3233 m above sea level. The published records give two slightly different positions for it; both are kept on the borehole nodes below."@en .

mis:source_railsback2015 a geolod:DataSource,
        owl:NamedIndividual ;
    rdfs:label "Railsback et al. (2015)"@en ;
    dct:bibliographicCitation "Railsback, L.B., Gibbard, P.L., Head, M.J., Voarintsoa, N.R.G., Toucanne, S. (2015): An optimized scheme of lettered marine isotope substages for the last 1.0 million years, and the climatostratigraphic nature of isotope stages and substages. Quaternary Science Reviews 111, 94-106."@en ;
    dct:source <https://doi.org/10.1016/j.quascirev.2015.01.012> ;
    geolod:coverageOldestAgeKaBP 1013.1 .

time:TimePosition rdfs:label "Time Position"@en ;
    rdfs:subClassOf crm:E54_Dimension .

geolod:LeadingAssignment a geolod:AssignmentStatus,
        owl:NamedIndividual ;
    rdfs:label "leading assignment"@en ;
    rdfs:comment "The assignment geo-lod follows for this property. Filtering on it yields one consistent value per property without knowing where a source's coverage ends."@en .

epica:core_edc a geolod:IceCore,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C ice core (EDC)"@en ;
    geolod:extractedFrom epica:site_dome_c ;
    crm:P2_has_type "Ice core"@en ;
    crm:P53_has_former_or_current_location epica:site_dome_c ;
    sosa:isSampleOf epica:site_dome_c .

geolod:UThChronology_140_sanbao a geolod:UThChronology ;
    rdfs:label "U-Th Chronology – Sanbao cave"@en ;
    rdfs:comment "Standardised SISAL chronology (linear interpolation / Bchron / Bacon / copRa / StalAge). See SISALv3 repository: https://doi.org/10.5287/ora-2nanwp4rk"@en .

geolod:Delta18OSpeleothemObservation a owl:Class ;
    rdfs:label "delta-18O Speleothem Observation"@en ;
    rdfs:comment "Oxygen isotope ratio (delta-18O) in permille VPDB from a speleothem. Proxy for hydroclimate, moisture source, temperature."@en ;
    rdfs:subClassOf geolod:SpeleothemObservation .

geolod:Delta18O_Speleothem a geolod:Delta18OProperty ;
    rdfs:label "delta-18O (speleothem)"@en .

geolod:MeasurementType_d18O a geolod:MeasurementType,
        owl:NamedIndividual ;
    rdfs:label "delta-18O Measurement"@en,
        "δ¹⁸O measurement"@en .

geolod:RollingMedian_w11 a geolod:RollingMedianFilter ;
    geolod:windowSize 11 .

geolod:SavitzkyGolay_w11_p2 a geolod:SavitzkyGolayFilter ;
    geolod:polyOrder 2 ;
    geolod:windowSize 11 .

