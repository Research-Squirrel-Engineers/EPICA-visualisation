mis:MIS_20 a geolod:MarineIsotopeStage,
        skos:Concept ;
    dct:source mis:source_lisieckiRaymo2005,
        mis:source_railsback2015 ;
    geolod:beginAgeKaBP 812.3 ;
    geolod:climateMode geolod:ClimateMode_Cold ;
    geolod:endAgeKaBP 790.9 ;
    geolod:leadingSource mis:source_railsback2015 ;
    skos:altLabel "20"@en ;
    skos:editorialNote "Stage-level boundaries derived as the union of the substage intervals; Railsback et al. (2015) list no stage row."@en ;
    skos:inScheme mis: ;
    skos:prefLabel "MIS 20"@en ;
    skos:topConceptOf mis: .

geolod:AlternativeAssignment a geolod:AssignmentStatus,
        owl:NamedIndividual ;
    rdfs:label "alternative assignment"@en ;
    rdfs:comment "A competing reading from another source, kept for comparison but not followed."@en .

fsl:Georeferencing rdfs:subClassOf crm:E13_Attribute_Assignment .

fsl:Site rdfs:subClassOf crm:E27_Site .

pleiades:Place rdfs:subClassOf crm:E53_Place .

geolod:CIFindspot a owl:Class ;
    rdfs:label "Campanian Ignimbrite Findspot"@en ;
    rdfs:comment "A documented findspot of Campanian Ignimbrite tephra. Modelled as crm:E27_Site so that geometry, name, and finds can attach via standard CRM patterns."@en ;
    rdfs:subClassOf crm:E27_Site .

ci:ci_findspots_generation a prov:Activity ;
    rdfs:label "CI findspot RDF generation"@en ;
    owl:versionInfo "sha256:bf282f412066" ;
    prov:used ci:ci_findspots_generation_input_ci_pipeline_py,
        ci:ci_findspots_generation_input_cifindspots_part_full_csv ;
    prov:wasAssociatedWith <https://github.com/Research-Squirrel-Engineers/campanian-ignimbrite-geo>,
        <https://orcid.org/0000-0002-3246-3531> .

geolod:DepthPosition a owl:Class ;
    rdfs:label "Depth Position"@en ;
    rdfs:comment "A position along the depth axis of an archive, in metres.  Used where a value published as an age has been carried into depth through a  depth-age model."@en ;
    rdfs:subClassOf crm:E54_Dimension .

geolod:LinearInterpolation a crmsci:S6_Data_Evaluation,
        owl:NamedIndividual ;
    rdfs:label "linear interpolation between neighbouring measurements"@en ;
    rdfs:comment "Straight-line interpolation between the two measured  depth-age pairs bracketing the target age. Not applied beyond the outermost  measurement of a record: an extrapolated boundary would state a depth the  record does not reach."@en .

geolod:MISBoundaryDepth a geolod:AssignedPropertyType,
        owl:NamedIndividual ;
    rdfs:label "stage boundary in depth"@en ;
    rdfs:comment "The depth at which a stage boundary falls in a given  archive, obtained by interpolation in a given chronology."@en .

unit:M rdfs:label "Metre"@en .

