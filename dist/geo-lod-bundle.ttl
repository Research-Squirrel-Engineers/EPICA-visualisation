geolod:Delta13CProperty a owl:Class ;
    rdfs:label "delta-13C Isotope Ratio Property"@en ;
    rdfs:comment "Stable carbon isotope ratio (delta-13C) in permille VPDB. Sensitive to vegetation dynamics, soil respiration, and prior calcite precipitation."@en ;
    rdfs:subClassOf geolod:ObservableProperty .

geolod:IceCore a owl:Class ;
    rdfs:label "Ice Core"@en ;
    rdfs:comment "A cylindrical ice sample extracted by drilling from a glacier or ice sheet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:extractedFrom ;
            owl:someValuesFrom geolod:DrillingSite ],
        geolod:PalaeoclimateSample,
        crm:E22_Human-Made_Object .

geolod:PalaeoclimateDataCatalogue a owl:Class ;
    rdfs:label "Palaeoclimate Data Catalogue"@en ;
    rdfs:comment "A DCAT catalogue aggregating palaeoclimate datasets."@en ;
    rdfs:subClassOf dcat:Catalog .

geolod:SISAL_Sites_Generation a prov:Activity ;
    rdfs:label "SISAL cave site RDF generation"@en ;
    owl:versionInfo "sha256:3c1017311690" ;
    prov:used geolod:SISAL_Sites_Generation_input_plot_sisal_from_csv_py,
        geolod:SISAL_Sites_Generation_input_v_sites_all_csv ;
    prov:wasAssociatedWith <https://orcid.org/0000-0002-3246-3531> .

