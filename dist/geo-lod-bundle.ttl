geolod:Speleothem a owl:Class ;
    rdfs:label "Speleothem"@en ;
    rdfs:comment "Secondary cave carbonate precipitate (stalagmite, stalactite, flowstone) used as palaeoclimate archive. Corresponds to entity/persist_id in SISALv3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:collectedFrom ;
            owl:someValuesFrom geolod:Cave ],
        geolod:PalaeoclimateSample,
        crm:E22_Human-Made_Object .

<http://orcid.org/0000-0002-3246-3531> a prov:Agent,
        foaf:Person ;
    skos:exactMatch <http://orcid.org/0000-0002-3246-3531> .

geolod:Speleothem_140_sanbao_e491 a geolod:Speleothem ;
    rdfs:label "Sanbao cave – SB34"@en ;
    geolod:collectedFrom geolod:Cave_site_0140 ;
    geolod:entityId 491 .

geolod:ArchaeologicalCaveSite a owl:Class ;
    rdfs:label "Archaeological Cave Site"@en ;
    rdfs:comment "A SISAL cave site that also carries confirmed or probable archaeological evidence (art, human occupation, skeletal remains, inscriptions, etc.). Modelling mirrors the CIArchaeologicalSite pattern from ci_pipeline.py."@en ;
    rdfs:subClassOf geolod:Cave,
        crmarchaeo1:A2_Stratigraphic_Volume_Unit .

