    rdfs:label "Speleothem Sampling Event"@en ;
    rdfs:comment "Scientific field event during which a speleothem was collected from a cave."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geolod:tookPlaceAt ;
            owl:someValuesFrom geolod:Cave ],
        [ a owl:Restriction ;
            owl:onProperty geolod:removedSample ;
            owl:someValuesFrom geolod:Speleothem ],
        crm:E7_Activity,
        crmsci:S1_Matter_Removal .

geolod:ageChronologySpeleothem a owl:ObjectProperty ;
    rdfs:label "age chronology (speleothem)"@en ;
    rdfs:comment "U-Th chronology used to assign a calendar age to this speleothem observation."@en ;
    rdfs:domain geolod:SpeleothemObservation ;
    rdfs:range geolod:UThChronology ;
    rdfs:subPropertyOf geolod:ageChronology .

geolod:archaeologicalBroaderContext a owl:ObjectProperty ;
    rdfs:label "archaeological broader context"@en ;
    rdfs:comment "Links the site to a controlled vocabulary term for its broader cultural-temporal context."@en ;
    rdfs:domain geolod:ArchaeologicalCaveSite ;
    rdfs:range geolod:ArchaeologicalContext .

geolod:archaeologicalCategory a owl:DatatypeProperty ;
    rdfs:label "archaeological category"@en ;
    rdfs:comment "Free-text classification of the archaeological character (e.g. 'Palaeolithic Art', 'Prehistoric Occupation')."@en ;
    rdfs:domain geolod:ArchaeologicalCaveSite ;
    rdfs:range xsd:string .

geolod:archaeologicalConfidence a owl:DatatypeProperty ;
    rdfs:label "archaeological confidence"@en ;
    rdfs:comment "Confidence level of the archaeological attribution (high / medium / low)."@en ;
    rdfs:domain geolod:ArchaeologicalCaveSite ;
    rdfs:range xsd:string .

geolod:assignmentStatus a owl:ObjectProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:domain crm:E13_Attribute_Assignment ;
    rdfs:range geolod:AssignmentStatus .

geolod:atDepth_m a owl:DatatypeProperty ;
    rdfs:label "at depth (m)"@en ;
    qudt:unit unit:M ;
    rdfs:domain geolod:IceCoreObservation ;
    rdfs:range xsd:decimal .

geolod:atDepth_mm a owl:DatatypeProperty ;
    rdfs:label "at depth (mm)"@en ;
    qudt:unit unit:MilliM ;
    rdfs:comment "Sampling depth in millimetres from top of speleothem. Corresponds to depth_sample in SISALv3."@en ;
    rdfs:domain geolod:SpeleothemObservation ;
    rdfs:range xsd:decimal .

geolod:beginAgeKaBP a owl:DatatypeProperty ;
    rdfs:label "beginning age (ka BP)"@en ;
    rdfs:comment "Materialised older boundary of a period, taken from the leading source. Competing values are reachable through the attribute assignments."@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf geolod:ageKaBP .

