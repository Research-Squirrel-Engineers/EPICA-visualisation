geolod:collectedFrom a owl:ObjectProperty ;
    rdfs:label "collected from"@en ;
    rdfs:comment "Links a speleothem to the cave from which it was collected."@en ;
    rdfs:domain geolod:Speleothem ;
    rdfs:range geolod:Cave ;
    rdfs:subPropertyOf sosa:isSampleOf .

geolod:extractedFrom a owl:ObjectProperty ;
    rdfs:label "extracted from"@en ;
    rdfs:domain geolod:PalaeoclimateSample ;
    rdfs:range geolod:SamplingLocation .

mis:MIS_TG6 a geolod:MarineIsotopeStage,
        skos:Concept ;
    dct:source mis:source_lisieckiRaymo2005 ;
    geolod:endAgeKaBP 5315.0 ;
    geolod:leadingSource mis:source_lisieckiRaymo2005 ;
    skos:altLabel "TG6"@en ;
    skos:editorialNote "Beyond the coverage of Railsback et al. (2015); boundaries from the LR04 stack only."@en ;
    skos:inScheme mis: ;
    skos:prefLabel "MIS TG6"@en ;
    skos:topConceptOf mis: .

