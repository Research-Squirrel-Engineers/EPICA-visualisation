geolod:climateMode a owl:ObjectProperty ;
    rdfs:label "climate mode"@en ;
    rdfs:comment "Materialised warm/cold classification. The assignment carrying the source is kept alongside as a geolod:MISAttributeAssignment."@en ;
    rdfs:domain geolod:MarineIsotopeStage ;
    rdfs:range geolod:ClimateMode .

geolod:countD13CSamples a owl:DatatypeProperty ;
    rdfs:label "count of d13C samples"@en ;
    rdfs:comment "Total number of delta-13C measurements available for this cave site across all entities in SISALv3 (column: n_d13c_samples in v_sites_all)."@en ;
    rdfs:domain geolod:Cave ;
    rdfs:range xsd:integer .

geolod:countD18OSamples a owl:DatatypeProperty ;
    rdfs:label "count of d18O samples"@en ;
    rdfs:comment "Total number of delta-18O measurements available for this cave site across all entities in SISALv3 (column: n_d18o_samples in v_sites_all)."@en ;
    rdfs:domain geolod:Cave ;
    rdfs:range xsd:integer .

geolod:coverageOldestAgeKaBP a owl:DatatypeProperty ;
    rdfs:label "oldest age covered (ka BP)"@en ;
    rdfs:comment "Oldest age a source reaches. Beyond it another source has to lead."@en ;
    rdfs:domain geolod:DataSource ;
    rdfs:range xsd:decimal .

geolod:crm-bridging a owl:Ontology ;
    rdfs:label "geo-lod ↔ CIDOC-CRM Bridging Axioms"@en ;
    dct:created "2026-04"^^xsd:gYearMonth ;
    rdfs:comment "Bridges external standard vocabularies (SOSA, PROV-O, GeoSPARQL, DCAT, FOAF, Dublin Core, Pleiades, fuzzy-sl) into the CIDOC-CRM family so that every instance in the geo-lod knowledge graph has a CRM-family ancestor. Required for ingestion into the NFDI4Objects Knowledge Graph."@en ;
    owl:imports geolod: .

geolod:endAgeKaBP a owl:DatatypeProperty ;
    rdfs:label "end age (ka BP)"@en ;
    rdfs:comment "Materialised younger boundary of a period, taken from the leading source."@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf geolod:ageKaBP .

geolod:entityId a owl:DatatypeProperty ;
    rdfs:label "SISAL entity ID"@en ;
    rdfs:comment "Unique dataset identifier in SISALv3 (entity_id). Multiple entity_ids may share the same persist_id (same physical speleothem, different time windows)."@en ;
    rdfs:domain geolod:Speleothem ;
    rdfs:range xsd:integer .

geolod:epica a owl:Ontology ;
    rdfs:label "EPICA Dome C Ice Core Ontology"@en ;
    dct:created "2026-08-08"^^xsd:date ;
    dct:description "OWL ontology for palaeoclimatic ice core observations from EPICA Dome C, East Antarctica. Covers CH4 and d18O measurements, smoothing methods, site geometry, drilling campaign and data provenance. Imports geo_lod_core.ttl."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "EPICA Dome C Ice Core Ontology"@en ;
    owl:imports geolod: ;
    owl:versionInfo "1.0.0" .

geolod:hasDrillingCampaign a owl:ObjectProperty ;
    rdfs:label "has drilling campaign"@en ;
    rdfs:domain geolod:IceCoreDataset ;
    rdfs:range geolod:DrillingCampaign .

geolod:hasObservation a owl:ObjectProperty ;
    rdfs:label "has observation"@en .

geolod:isUNESCOWorldHeritage a owl:DatatypeProperty ;
    rdfs:label "is UNESCO World Heritage"@en ;
    rdfs:comment "True if the cave site lies within a UNESCO World Heritage property."@en ;
    rdfs:domain geolod:Cave ;
    rdfs:range xsd:boolean .

geolod:leadingSource a owl:ObjectProperty ;
    rdfs:label "leading source"@en ;
    rdfs:comment "The source geo-lod follows for this entity where the sources disagree."@en ;
    rdfs:range geolod:DataSource .

geolod:measuredValue a owl:DatatypeProperty ;
    rdfs:label "measured value"@en ;
    rdfs:domain geolod:PalaeoclimateObservation ;
    rdfs:range xsd:decimal .

geolod:measurementType a owl:ObjectProperty ;
    rdfs:label "measurement type"@en ;
    rdfs:domain geolod:PalaeoclimateObservation ;
    rdfs:range geolod:MeasurementType .

geolod:peakAgeKaBP a owl:DatatypeProperty ;
    rdfs:label "peak age (ka BP)"@en ;
    rdfs:comment "Materialised age of the excursion a substage labels."@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf geolod:ageKaBP .

geolod:polyOrder a owl:DatatypeProperty ;
    rdfs:label "polynomial order"@en ;
    rdfs:domain geolod:SavitzkyGolayFilter ;
    rdfs:range xsd:integer .

geolod:sisal-ontology a owl:Ontology ;
    rdfs:label "geo-lod SISAL Ontology"@en ;
    dct:created "2024"^^xsd:gYear ;
    dct:source <https://doi.org/10.5194/essd-16-1933-2024> ;
    rdfs:comment "Ontology for speleothem palaeoclimate data, aligned with the SISALv3 database schema (Kaushal et al. 2024, ESSD 16, 1933-1963). Extends the geo-lod ice-core vocabulary with cave-specific classes, properties, and site-level statistics."@en ;
    owl:imports geolod: .

geolod:siteId a owl:DatatypeProperty ;
    rdfs:label "SISAL site ID"@en ;
    rdfs:comment "Unique site identifier in SISALv3 (site_id)."@en ;
    rdfs:domain geolod:Cave ;
    rdfs:range xsd:integer .

geolod:smoothedValue_rollingMedian a owl:DatatypeProperty ;
    rdfs:label "smoothed value (rolling median)"@en ;
    rdfs:domain geolod:PalaeoclimateObservation ;
    rdfs:range xsd:decimal .

geolod:smoothedValue_savgol a owl:DatatypeProperty ;
    rdfs:label "smoothed value (Savitzky-Golay)"@en ;
    rdfs:domain geolod:PalaeoclimateObservation ;
    rdfs:range xsd:decimal .

geolod:smoothingMethod_median a owl:ObjectProperty ;
    rdfs:label "smoothing method (rolling median)"@en ;
    rdfs:domain geolod:PalaeoclimateObservation ;
    rdfs:range geolod:RollingMedianFilter .

geolod:smoothingMethod_savgol a owl:ObjectProperty ;
    rdfs:label "smoothing method (Savitzky-Golay)"@en ;
    rdfs:domain geolod:PalaeoclimateObservation ;
    rdfs:range geolod:SavitzkyGolayFilter .

trs: a owl:Ontology ;
    rdfs:label "geo-lod Temporal Reference Systems"@en ;
    rdfs:comment "Temporal reference systems used by geo-lod, one per chronology. All express age in thousands of years before present (ka BP)."@en ;
    owl:imports geolod: .

geolod:unescoWHId a owl:ObjectProperty ;
    rdfs:label "UNESCO WH identifier"@en ;
    rdfs:comment "URI of the UNESCO World Heritage list entry (https://whc.unesco.org/en/list/{id})."@en ;
    rdfs:domain geolod:Cave .

mis:assign_climateMode_MIS_1 a geolod:MISAttributeAssignment ;
    dct:source mis:source_railsback2015 ;
    geolod:assignmentStatus geolod:LeadingAssignment ;
    crm:P140_assigned_attribute_to mis:MIS_1 ;
    crm:P141_assigned geolod:ClimateMode_Warm ;
    crm:P177_assigned_property_of_type geolod:ClimateModeType ;
    rdfs:comment "Parity convention: odd-numbered stages are warm, even-numbered stages cold, as discussed by Railsback et al. (2015)."@en .

