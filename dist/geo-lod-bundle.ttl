crm:E27_Site rdfs:label "Site"@en ;
    rdfs:comment "A place that was or is the focus of human activity (CIDOC-CRM E27)."@en .

crm:E7_Activity rdfs:label "Activity"@en .

crmsci:S4_Observation rdfs:label "Observation"@en ;
    rdfs:comment "A scientific observation event (CRMsci S4)."@en .

geolod:Cave_site_0144 a geolod:Cave ;
    rdfs:label "Botuverá cave"@en ;
    geolod:countD13CSamples 920 ;
    geolod:countD18OSamples 920 ;
    geolod:siteId 144 ;
    geo:hasGeometry geolod:Cave_site_0144_Geometry ;
    prov:wasDerivedFrom geolod:SISALv3_DataSource .

geolod:PalaeoclimateSample a owl:Class ;
    rdfs:label "Palaeoclimate Sample"@en ;
    rdfs:comment "A physical archive recording a palaeoclimate signal  (ice core or speleothem)."@en ;
    rdfs:subClassOf crm:E18_Physical_Thing,
        sosa:Sample .

geolod:SavitzkyGolayFilter a owl:Class ;
    rdfs:label "Savitzky-Golay Filter"@en ;
    rdfs:comment "Polynomial least-squares smoothing filter preserving  higher signal moments."@en ;
    rdfs:subClassOf geolod:SmoothingMethod .

geolod:SpeleothemObservation a owl:Class ;
    rdfs:label "Speleothem Observation"@en ;
    rdfs:comment "Single stable isotope measurement on a speleothem sample, characterised by depth (mm), calendar age (ka BP) and measured value. Corresponds to a row in the d18O or d13C table of SISALv3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom geolod:Speleothem ],
        [ a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom geolod:ObservableProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom geolod:DataSource ],
        geolod:PalaeoclimateObservation .

