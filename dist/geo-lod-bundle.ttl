geolod:windowSize a owl:DatatypeProperty ;
    rdfs:label "window size"@en ;
    rdfs:comment "Number of data points in the smoothing window."@en ;
    rdfs:domain geolod:SmoothingMethod ;
    rdfs:range xsd:integer .

crm:P2_has_type rdfs:label "has type"@en .

crm:P4_has_time-span rdfs:label "has time-span"@en .

crm:P53_has_former_or_current_location rdfs:label "has former or current location"@en .

crm:P7_took_place_at rdfs:label "took place at"@en .

crm:P87_is_identified_by rdfs:label "is identified by"@en .

crmsci:O1_removed rdfs:label "removed"@en .

geo:Geometry rdfs:label "Geometry"@en ;
    rdfs:comment "A coherent set of direct positions in space (OGC GeoSPARQL)."@en .

geo:asWKT rdfs:label "as WKT"@en .

geo:hasGeometry rdfs:label "has geometry"@en .

skos:Collection rdfs:subClassOf crm:E78_Curated_Holding .

dcat:Distribution rdfs:label "Distribution"@en .

sosa:hasSimpleResult rdfs:label "has simple result"@en .

sosa:resultTime rdfs:label "result time"@en .

unit:M rdfs:label "Metre"@en .

geolod:CH4ConcentrationProperty a owl:Class ;
    rdfs:label "Methane Concentration Property"@en ;
    rdfs:comment "CH4 concentration in ppbv, measured from air bubbles trapped in ice."@en ;
    rdfs:subClassOf geolod:ObservableProperty .

