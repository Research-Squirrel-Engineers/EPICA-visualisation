@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ns1: <http://w3id.org/geo-lod/> .
@prefix ns2: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/geo-lod/epica/borehole_edc99> a ns1:Borehole,
        owl:NamedIndividual,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "EDC99 / EDC (EPICA Dome C)"@en ;
    void:inDataset ns1:geo-lod ;
    ns1:elevation_m 3233.0 ;
    ns2:P89_falls_within <http://w3id.org/geo-lod/epica/site_dome_c> ;
    geo:hasGeometry <http://w3id.org/geo-lod/epica/geom_borehole_edc99> ;
    rdfs:comment "Event as recorded in the CH4, deuterium and dust datasets. Drilling ran 1996-2004; the first hole (EDC96) was abandoned at 788 m in 1999 and the record continues in EDC99."@en .

