<http://w3id.org/geo-lod/epica/property_do2n2> a <http://w3id.org/geo-lod/ObservableProperty>,
        owl:NamedIndividual,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "δO₂/N₂"@en ;
    ns1:unit <http://qudt.org/vocab/unit/PERMILLE> ;
    void:inDataset <http://w3id.org/geo-lod/geo-lod> ;
    rdfs:comment "Ratio of oxygen to nitrogen in the trapped air. Sensitive to local summer insolation at bubble close-off, hence its use for dating."@en .

