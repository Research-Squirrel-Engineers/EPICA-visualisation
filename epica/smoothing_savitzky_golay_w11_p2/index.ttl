<http://w3id.org/geo-lod/epica/smoothing_savitzky_golay_w11_p2> a ns1:SavitzkyGolayFilter,
        owl:NamedIndividual,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Savitzky-Golay filter, window 11, polynomial order 2"@en ;
