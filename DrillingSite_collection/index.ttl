@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/geo-lod/DrillingSite_collection> a geo:FeatureCollection,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "DrillingSite Instances Collection"@en ;
    void:inDataset <http://w3id.org/geo-lod/geo-lod> ;
    dcat:dataset <http://w3id.org/geo-lod/epica/site_dome_c> .

