geolod:DatingMethod_actively_forming a geolod:DatingMethod,
        owl:NamedIndividual ;
    skos:definition "Not a laboratory measurement: the top of the record was observed to be growing, which dates it to the year of collection."@en ;
    skos:prefLabel "actively forming"@en .

geolod:DatingMethod_multiple a geolod:DatingMethod,
        owl:NamedIndividual ;
    skos:definition "More than one method combined into a single reported age."@en ;
    skos:prefLabel "multiple methods"@en .

geolod:DatingMethod_tims a geolod:DatingMethod,
        owl:NamedIndividual ;
    skos:definition "Uranium-thorium disequilibrium dating on a thermal ionisation mass spectrometer."@en ;
    skos:prefLabel "TIMS"@en .

geolod:DatingMethod_mc_icp_ms_u_th a geolod:DatingMethod,
        owl:NamedIndividual ;
    skos:definition "Uranium-thorium disequilibrium dating on a multi-collector inductively coupled plasma mass spectrometer."@en ;
    skos:prefLabel "MC-ICP-MS U/Th"@en .

