@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci: <http://www.ics.forth.gr/isl/CRMsci/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix epica: <http://w3id.org/geo-lod/epica/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix geolod: <http://w3id.org/geo-lod/> .
@prefix mis: <http://w3id.org/geo-lod/vocab/mis/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix trs: <http://w3id.org/geo-lod/trs/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

geolod:AllPalaeoclimateSites_Collection a geo:FeatureCollection,
        owl:NamedIndividual ;
    rdfs:label "All palaeoclimate sites collection"@en ;
    rdfs:member epica:site_dome_c .

epica:borehole_domec a geolod:Borehole,
        owl:NamedIndividual ;
    rdfs:label "DomeC"@en ;
    geolod:elevation_m 3233.0 ;
    crm:P89_falls_within epica:site_dome_c ;
    geo:hasGeometry epica:geom_borehole_domec ;
    rdfs:comment "Event as recorded in the two 2023 gas datasets. The coordinates differ from the EDC99 event by about 1.3 km although the material is from the same core; this is a difference between metadata records, not evidence of a second borehole."@en .

epica:borehole_edc99 a geolod:Borehole,
        owl:NamedIndividual ;
    rdfs:label "EDC99 / EDC (EPICA Dome C)"@en ;
    geolod:elevation_m 3233.0 ;
    crm:P89_falls_within epica:site_dome_c ;
    geo:hasGeometry epica:geom_borehole_edc99 ;
    rdfs:comment "Event as recorded in the CH4, deuterium and dust datasets. Drilling ran 1996-2004; the first hole (EDC96) was abandoned at 788 m in 1999 and the record continues in EDC99."@en .

epica:campaign_1996_2004 a geolod:DrillingCampaign,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C drilling campaign 1996-2004"@en ;
    geolod:removedSample epica:core_edc ;
    geolod:tookPlaceAt epica:site_dome_c ;
    crm:P4_has_time-span "1996/2004"^^xsd:string ;
    crmsci:O1_removed epica:core_edc .

epica:catalog a geolod:PalaeoclimateDataCatalogue,
        owl:NamedIndividual,
        dcat:Catalog ;
    rdfs:label "EPICA Dome C ice core - linked data catalogue"@en ;
    dct:created "2026-08-08"^^xsd:date ;
    dct:description "Five proxy records from the EPICA Dome C ice core, East Antarctica: methane, deuterium, dust, the oxygen isotope composition of trapped air, and the oxygen to nitrogen ratio of trapped air. The records rest on four different depth-age models and are not on a common time axis; each observation names the chronology its age comes from."@en ;
    dct:publisher "PANGAEA - Data Publisher for Earth & Environmental Science" ;
    dct:title "EPICA Dome C ice core - linked data catalogue"@en ;
    dcat:dataset epica:dataset_ch4,
        epica:dataset_d18o,
        epica:dataset_dd,
        epica:dataset_do2n2,
        epica:dataset_dust .

epica:collection_drilling_sites a geo:FeatureCollection,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C drilling site collection"@en ;
    rdfs:member epica:site_dome_c .

epica:mis_boundary_depth_ch4_11_begin a geolod:MISAttributeAssignment ;
    rdfs:label "Beginning of MIS 11 at 2792.27 m in the CH4 record"@en ;
    dct:source mis:source_railsback2015 ;
    geolod:assignmentStatus geolod:LeadingAssignment ;
    geolod:inChronology trs:EDC2-gas ;
    geolod:interpolationMethod geolod:LinearInterpolation ;
    crm:P140_assigned_attribute_to mis:MIS_11 ;
    crm:P141_assigned epica:depth_position_ch4_11_begin ;
    crm:P177_assigned_property_of_type geolod:MISBoundaryDepth ;
    rdfs:comment "Depth obtained by linear interpolation between the two measurements bracketing 428.3 ka BP on the EDC2-gas scale. Valid for this record only."@en ;
    prov:wasDerivedFrom mis:tp_railsback2015_MIS_11_begin .

