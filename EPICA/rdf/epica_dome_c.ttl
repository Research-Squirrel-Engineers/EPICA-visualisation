epica:measurement_type_ch4 a geolod:MeasurementType,
        owl:NamedIndividual ;
    rdfs:label "Methane (CH₄) measurement"@en ;
    crm:P2_has_type "Gas chromatography"@en .

epica:property_ch4 a geolod:ObservableProperty,
        owl:NamedIndividual ;
    rdfs:label "Methane (CH₄)"@en ;
    qudt:unit unit:PPB ;
    rdfs:comment "Methane concentration of the air trapped in the ice, in ppbv."@en .

epica:source_ch4 a geolod:DataSource,
        owl:NamedIndividual ;
    rdfs:label "Spahni & Stocker (2006)"@en ;
    dct:creator "Spahni, R.; Stocker, T. F." ;
    dct:date "2006"^^xsd:gYear ;
    dct:license <https://creativecommons.org/licenses/by/3.0/> ;
    dct:source <https://doi.org/10.1594/PANGAEA.472484> ;
    dct:title "EPICA Dome C - methane (CH4)"@en ;
    owl:sameAs <https://doi.org/10.1594/PANGAEA.472484> .

epica:measurement_type_dd a geolod:MeasurementType,
        owl:NamedIndividual ;
    rdfs:label "Deuterium (δD) measurement"@en ;
    crm:P2_has_type "Isotope ratio mass spectrometry"@en .

epica:property_dd a geolod:ObservableProperty,
        owl:NamedIndividual ;
    rdfs:label "Deuterium (δD)"@en ;
    qudt:unit unit:PERMILLE ;
    rdfs:comment "Deuterium content of the ice itself, relative to SMOW. This is the water-isotope record of the core and the usual temperature proxy."@en .

epica:source_dd a geolod:DataSource,
        owl:NamedIndividual ;
    rdfs:label "Augustin et al. (2004), Nature 429"@en ;
    dct:creator "Augustin, L. et al. (EPICA community members)" ;
    dct:date "2004"^^xsd:gYear ;
    dct:license <https://creativecommons.org/licenses/by/3.0/> ;
    dct:source <https://doi.org/10.1594/PANGAEA.198743> ;
    dct:title "EPICA Dome C - deuterium (δD)"@en ;
    owl:sameAs <https://doi.org/10.1594/PANGAEA.198743> .

epica:measurement_type_do2n2 a geolod:MeasurementType,
        owl:NamedIndividual ;
    rdfs:label "δO₂/N₂ measurement"@en ;
    crm:P2_has_type "Isotope Ratio Mass Spectrometer (IRMS)"@en .

epica:property_do2n2 a geolod:ObservableProperty,
        owl:NamedIndividual ;
    rdfs:label "δO₂/N₂"@en ;
    qudt:unit unit:PERMILLE ;
    rdfs:comment "Ratio of oxygen to nitrogen in the trapped air. Sensitive to local summer insolation at bubble close-off, hence its use for dating."@en .

epica:source_do2n2 a geolod:DataSource,
        owl:NamedIndividual ;
    rdfs:label "Bouchet et al. (2023)"@en ;
    dct:creator "Bouchet, M. et al." ;
    dct:date "2023"^^xsd:gYear ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://doi.org/10.1594/PANGAEA.961025> ;
    dct:title "EPICA Dome C - δO2/N2"@en ;
    owl:sameAs <https://doi.org/10.1594/PANGAEA.961025> .

epica:measurement_type_dust a geolod:MeasurementType,
        owl:NamedIndividual ;
    rdfs:label "Dust concentration measurement"@en ;
    crm:P2_has_type "Coulter counter"@en .

epica:property_dust a geolod:ObservableProperty,
        owl:NamedIndividual ;
    rdfs:label "Dust concentration"@en ;
    qudt:unit unit:MicroGM-PER-KiloGM ;
    rdfs:comment "Mass concentration of insoluble dust particles in the melted ice, measured with a Coulter counter."@en .

epica:source_dust a geolod:DataSource,
        owl:NamedIndividual ;
    rdfs:label "Lambert et al. (2008)"@en ;
    dct:creator "Lambert, F. et al." ;
    dct:date "2008"^^xsd:gYear ;
    dct:license <https://creativecommons.org/licenses/by/3.0/> ;
    dct:source <https://doi.org/10.1594/PANGAEA.695984> ;
    dct:title "EPICA Dome C - dust concentration (Coulter counter)"@en ;
    owl:sameAs <https://doi.org/10.1594/PANGAEA.695984> .

epica:measurement_type_d18o a geolod:MeasurementType,
        owl:NamedIndividual ;
    rdfs:label "δ¹⁸O of O₂ measurement"@en ;
    crm:P2_has_type "Isotope Ratio Mass Spectrometer (IRMS)"@en .

epica:property_d18o a geolod:ObservableProperty,
        owl:NamedIndividual ;
    rdfs:label "δ¹⁸O of O₂"@en ;
    qudt:unit unit:PERMILLE ;
    rdfs:comment "Oxygen isotope composition of molecular oxygen in the trapped air, not of the ice. Reflects the composition of the atmosphere, and is used for orbital dating rather than as a local temperature proxy."@en .

epica:source_d18o a geolod:DataSource,
        owl:NamedIndividual ;
    rdfs:label "Bouchet et al. (2023)"@en ;
    dct:creator "Bouchet, M. et al." ;
    dct:date "2023"^^xsd:gYear ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://doi.org/10.1594/PANGAEA.961024> ;
    dct:title "EPICA Dome C - δ18O of atmospheric O2"@en ;
    owl:sameAs <https://doi.org/10.1594/PANGAEA.961024> .

epica:smoothing_rolling_median_w11 a geolod:RollingMedianFilter,
        owl:NamedIndividual ;
    rdfs:label "Rolling median filter, window 11"@en ;
    dct:references <https://doi.org/10.1145/1968.1969> ;
    geolod:windowSize 11 .

epica:smoothing_savitzky_golay_w11_p2 a geolod:SavitzkyGolayFilter,
        owl:NamedIndividual ;
    rdfs:label "Savitzky-Golay filter, window 11, polynomial order 2"@en ;
    dct:references <https://doi.org/10.1021/ac60214a047> ;
    geolod:polyOrder 2 ;
    geolod:windowSize 11 .

epica:site_dome_c a geolod:DrillingSite,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C, East Antarctica"@en ;
    crm:P87_is_identified_by "EDC"^^xsd:string ;
    geo:hasGeometry epica:geom_borehole_edc99 ;
    rdfs:comment "Drilling site of the European Project for Ice Coring in Antarctica on the East Antarctic plateau, 3233 m above sea level. The published records give two slightly different positions for it; both are kept on the borehole nodes below."@en .

epica:core_edc a geolod:IceCore,
        owl:NamedIndividual ;
    rdfs:label "EPICA Dome C ice core (EDC)"@en ;
    geolod:extractedFrom epica:site_dome_c ;
    crm:P2_has_type "Ice core"@en ;
    crm:P53_has_former_or_current_location epica:site_dome_c ;
    sosa:isSampleOf epica:site_dome_c .

